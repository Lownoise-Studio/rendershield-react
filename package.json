{
    "name": "@lownoise-studio/render-shield-react",
    "version": "1.0.0",
    "description": "Open-source React render-boundary diagnostics and shielding library.",
    "license": "MIT",
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Lownoise-Studio/rendershield-react.git"
    },
    "bugs": {
        "url": "https://github.com/Lownoise-Studio/rendershield-react/issues"
    },
    "homepage": "https://github.com/Lownoise-Studio/rendershield-react#readme",
    "keywords": [
        "react",
        "react-performance",
        "rerender",
        "diagnostics",
        "react-memo",
        "hooks",
        "typescript",
        "devtools",
        "render",
        "memo"
    ],
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest",
        "test:run": "vitest run",
        "test:packaging": "node scripts/packaging-smoke.mjs",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run typecheck && npm run test:run && npm run build"
    },
    "peerDependencies": {
        "react": ">=18"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.0.0",
        "@testing-library/react": "^16.0.0",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "jsdom": "^29.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.8.0",
        "vitest": "^3.2.7"
    }
}
